{
  "name": "access_emarket",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build --production",
    "start": "node server.js",
    "test": "node ace test",
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write ."
  },
  "eslintConfig": {
    "extends": [
      "plugin:adonis/typescriptApp",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error"
      ]
    }
  },
  "eslintIgnore": [
    "build"
  ],
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "useTabs": false,
    "quoteProps": "consistent",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 100
  },
  "devDependencies": {
    "@adonisjs/assembler": "^5.9.5",
    "@babel/core": "^7.21.3",
    "@babel/preset-env": "^7.20.2",
    "@faker-js/faker": "^7.6.0",
    "@japa/preset-adonis": "^1.2.0",
    "@japa/runner": "^2.5.1",
    "@symfony/webpack-encore": "^4.1.1",
    "@types/proxy-addr": "^2.0.0",
    "@types/source-map-support": "^0.5.6",
    "adonis-preset-ts": "^2.1.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-adonis": "^2.1.1",
    "eslint-plugin-prettier": "^4.2.1",
    "pino-pretty": "^10.0.0",
    "postcss-loader": "^7.1.0",
    "prettier": "^2.8.7",
    "typescript": "~4.6",
    "webpack": "^5.76.3",
    "webpack-cli": "^4.10.0",
    "youch": "^3.2.3",
    "youch-terminal": "^2.2.0"
  },
  "dependencies": {
    "@adonisjs/antl": "^2.0.7",
    "@adonisjs/auth": "^8.2.3",
    "@adonisjs/bodyparser": "^8.1.7",
    "@adonisjs/core": "^5.9.0",
    "@adonisjs/cors": "^1.0.7",
    "@adonisjs/fold": "^8.2.0",
    "@adonisjs/lucid": "^18.3.0",
    "@adonisjs/mail": "^8.1.2",
    "@adonisjs/repl": "^3.1.11",
    "@adonisjs/session": "^6.4.0",
    "@adonisjs/shield": "^7.1.0",
    "@adonisjs/view": "^6.2.0",
    "@adonisjs/websocket": "^1.0.12",
    "@mezielabs/flair": "^1.0.6",
    "@tailwindcss/forms": "^0.5.3",
    "alpinejs": "^3.12.0",
    "apexcharts": "^3.37.2",
    "autoprefixer": "^10.4.14",
    "axios": "^1.3.4",
    "body-parser": "^1.20.2",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.30.0",
    "emittery": "^1.0.1",
    "faker": "^5.5.3",
    "flowbite": "^1.6.4",
    "form-data": "^4.0.0",
    "luxon": "^3.3.0",
    "moment": "^2.29.4",
    "mssql": "^9.1.1",
    "mysql2": "^3.2.0",
    "oracledb": "^5.5.0",
