    <script>
      const dates = "{{  cals.Base.cal1.dates }}"


      var options1 = {
        chart: {
          type: 'line'
        },
        series: [{
          name: 'Calendrier 01 Base',
          data: [{{ cals.Base.cal1.prices }}]
,
      },{
      name: 'Calendrier 02 Base',
      data: [{{ cals.Base.cal2.prices }}]
,
      },{
      name: 'Calendrier 03 Base',
      data: [{{ cals.Base.cal3.prices }}]
,
      },{
      name: 'Calendrier 01 Peak',
