,
      },{
      name: 'Calendrier 03 Peak',
      data: [{{ cals.Peak.cal3.prices }}]
,
      }],
        xaxis: {
          categories: dates.split(',')
        },
        colors: ['#34d399', '#334155'],
        stroke: {
          curve: 'smooth',
        }
            };

      var chart1 = new ApexCharts(document.querySelector("#chart1"), options1);

      chart1.render();

    </script>
