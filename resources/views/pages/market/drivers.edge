  <script>
    let periodes = document.querySelector('#periodes1','#periodes2')

       let datesCo2 = "{{ drivers.co2.dates }}"
       let  datesCharbon = "{{ drivers.charbon.dates }}"
       let datesPetrole = "{{ drivers.petrole.dates }}"

        // ---------------------------------------------------------------
        var options1 = {
        chart: {
        type: 'line'
        },
        series: [{
          name: 'Charbon',
          data: [{{   drivers.charbon.prices  }}]
        }
        ],
        xaxis: {
        categories:   datesCharbon.split(",")
        },
        colors: ['#34d399','#334255']
        ,stroke: {
        curve: 'smooth',
        }
        };

        var chart1 = new ApexCharts(document.querySelector("#chart1"), options1);

        chart1.render();

        // ---------------------------------------------------------------
        var options2 = {
        chart: {
