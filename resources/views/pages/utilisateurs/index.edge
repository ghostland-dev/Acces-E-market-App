      @if(utilisateurs.length > 0)
      @each(utilisateur in utilisateurs)
      <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 ">
        <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
          {{ utilisateur.name}}
        </th>

        <td class="px-6 py-4">

          @if(utilisateur.role === 'administrateur')
          <span class=" bg-orange-50 p-2 text-orange-400 font-semibold rounded-md"><i class="fa fa-star  mx-2"
              aria-hidden="true"></i> Super Admin </span>
          @elseif(utilisateur.role === 'visiteur')
          <span class=" bg-slate-50 p-2 text-slate-400 font-semibold rounded-md">🥸 Visiteur </span>
          @elseif(utilisateur.role==='client' )
          <span class=" bg-blue-50 p-2 text-blue-400 font-semibold rounded-md">🕺🏼Client </span>
          @elseif(utilisateur.role==='partenaire' )
          <span class=" bg-indigo-50 p-2 text-indigo-400 font-semibold rounded-md">🏯Partenaire</span>
          @elseif(utilisateur.role === 'commercial')
          <span class=" bg-emerald-50 p-2 text-emerald-400 font-semibold rounded-md">🦸 Commercial </span>
          @else
          <span class=" bg-indigo-100 p-2 text-indigo-400 font-semibold rounded-md">🤔 sans Inconnu </span>
          @endif



        </td>
        <td class="px-6 py-4">
          {{ utilisateur.email}}
        </td>
        <td class="px-6 py-4">
          {{ utilisateur.remember_me_token? "Oui":"Non"}}
        </td>
        <td class="px-6 py-4">
          <span
            class="bg-red-100 text-red-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">{{
            utilisateur.email_verified_at ? "verifié": "en attente" }}</span>
        </td>
        <td class="px-6 py-4">
          <span
            class="bg-green-100 text-green-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">{{
            utilisateur.id}}</span>
        </td>

        <td class="flex justify-between px-6 py-4 text-right">
          <form action="{{ route('utilisateur.destroy', { id: utilisateur.id }) }}" method="POST" id="delete">

            {{ csrfField() }}

            <input type="hidden" name="_method" value="DELETE">
          </form>

          <button type="submit" onclick="document.querySelector('#delete').submit()"
            class="p-2 font-medium text-red-500 bg-red-100 rounded dark:text-red-500 "><i
              class="fa fa-trash"></i></button>

          <a href="{{ route('utilisateur.edit', { id: utilisateur.id }) }}"
            class="p-2 font-medium text-orange-300 bg-orange-100 rounded dark:text-orange-500 "><i
              class="fa fa-pen"></i></a>
          <a href="{{ route('utilisateur.show', { id: utilisateur.id }) }}"
            class="p-2 font-medium rounded bg-emerald-100 text-emerald-300 dark:text-emerald-500 "><i
              class="fa fa-eye"></i></a>


        </td>
      </tr>
