<!-- Large Modal -->
<div id="large-modal" tabindex="-1"
  class="fixed rounded-xl top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] md:h-full">
  <div class="relative w-full h-full max-w-4xl md:h-auto rounded-xl">
