                  <option selected="">Selectionnez un type d'énérgie</option>
                  <option value="gaz">Gaz</option>
                  <option value="electrecite">Electrcité</option>
                  <option value="charbon">Charbon</option>
                  <option value="co2">CO2</option>
                  <option value="petrole">Pétrole</option>
                </select>
              </div>
              <div class="w-full">
                <label for="type" name="type" class="block mb-1 text-sm font-medium text-gray-900 dark:text-white">Type
