    <tbody>

      @if(Alerts.length > 0)
      @each(alert in Alerts)
      <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 ">

        <td class="px-6 py-4">
          {{ alert.type}}
        </td>
        <td class="px-6 py-4">
          {{ alert.energie}}
        </td>

        <td class="px-6 py-4">
          {{ alert.nom }} {{ alert.prenom}}
        </td>

        <td class="px-6 py-4">
          {{ alert.tel}}
        </td>

        <td class="px-6 py-4">
          {{ alert.email}}
        </td>
        <td class="px-6 py-4">

          <span class="{{ alert.actif? " text-emerald-800 bg-emerald-100" :"text-red-800 bg-red-100"}} text-xs
            font-medium mr-2 px-2.5 py-0.5 rounded ">
            {{ alert.actif? " Activé" :"Disactivé"}} </span>
        </td>

        <td class="px-6 py-4">
          {{ alert.siret}}
        </td>

        <td class="px-6 py-4">
          {{ alert.energie}}
        </td>
        <td class="px-6 py-4">
          <span
            class="bg-red-100 text-red-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300">{{
            alert.max}}</span>
        </td>
        <td class="px-6 py-4">
          <span
            class="bg-green-100 text-green-800 text-xs font-medium mr-2 px-2.5 py-0.5 rounded dark:bg-green-900 dark:text-green-300">{{
            alert.min}}</span>
        </td>
        <td class="px-6 py-4">
          {{ alert.userId.name}}
        </td>
        <td class="flex justify-between px-6 py-4 text-right">
          <form action="{{ route('alerte.delete', { id: alert.id }) }}" method="post" id="delete">
            {{ csrfField() }}
            <button type="submit"></button>
          </form>

          <a href="#" class="p-2 mx-1 font-medium text-red-300 bg-red-100 rounded dark:text-orange-500 "
            onclick="document.getElementById('delete').submit()"><i class="fa fa-trash"></i></a>
          <a href="{{ route('alerte.edit', { id: alert.id }) }}"
            class="p-2 mx-1 font-medium text-orange-300 bg-orange-100 rounded dark:text-orange-500 "><i
              class="fa fa-pen"></i></a>
          <a href="{{ route('alerte.show', { id: alert.id }) }}"
            class="p-2 mx-1 font-medium rounded bg-emerald-100 text-emerald-300 dark:text-emerald-500 "><i
              class="fa fa-eye"></i></a>


        </td>
      </tr>
      @end
      @else
      <td>

      <th class="w-full p-4 text-lg font-normal text-center">
        Désolé aucun alerte dans la base des données
      </th>

      </td>
      @endif




    </tbody>
  </table>
</div>


<script>
  const searchInput = document.querySelector('#default-search');
  const searchForm = document.querySelector('#form-search');

  searchForm.addEventListener('focus', (e) => {
    e.preventDefault();
    const searchQuery = searchInput.value;

    fetch(`/alerts/search?search=${encodeURIComponent(searchQuery)}`)
      .then((response) => response.json())
      .then((data) => {
        // Update the alerts list with the received data
        // Implement the logic to update the HTML based on the data
        console.log(data);
      })
      .catch((error) => {
        console.error('An error occurred while fetching search results:', error);
      });
  });
</script>
@endsection
