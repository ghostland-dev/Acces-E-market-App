    <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
      <section class="bg-white dark:bg-gray-900">
        <div class="px-4 py-16 mx-auto w-90 lg:pt-8">
          <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Créer un nouveau alerte</h2>
          <form action="{{ route('nouveauAlerte') }}" method="POST" class="p-3">
            {{ csrfField() }}

            <div class="grid gap-4 sm:grid-cols-3 sm:gap-6">
              <div class="sm:col-span-2">
