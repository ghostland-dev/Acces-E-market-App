      <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 ">

        <td class="px-6 py-4">
          {{ elec.prix_base}} €
        </td>

        <td class="px-6 py-4">
          {{ elec.prix_min_base}} €
        </td>

        <td class="px-6 py-4">
          {{ elec.prix_avg_base}} €
        </td>

        <td class="px-6 py-4">
