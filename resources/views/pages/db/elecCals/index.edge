            {{ csrfField() }}
            <button type="submit"></button>
          </form>

          <a href="#" class="p-2 mx-1 font-medium text-red-300 bg-red-100 rounded dark:text-orange-500 "
            onclick="document.getElementById('delete').submit()"><i class="fa fa-trash"></i></a>
          <a href="{{ route('electricite.edit', { id: elec.id }) }}"
            class="p-2 mx-1 font-medium text-orange-300 bg-orange-100 rounded dark:text-orange-500 "><i
              class="fa fa-pen"></i></a>


        </td>




      </tr>
