          <p class="text-sm font-bold mb-4 text-slate-400 shadow p-4 rounded-lg w-full"><span
              class=" text-sm text-emerald-400 bg-gray-100 p-3 rounded-full mr-2">MOY</span> {{ variations.elec.base.avg
            }}
            €/kw </p>

        </div>

