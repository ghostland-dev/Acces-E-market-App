        <div class=" flex justify-evenly  text-center">

          <p class=" font-bold mb-4 text-slate-400  shadow p-4 rounded-lg w-full"> <i
              class="text-sm text-emerald-300 bg-gray-50 p-3 rounded-full mr-2 fa fa-arrow-up"></i>
            {{energieData.electrcite.lastBaseload}} €/kw <span
              class="text-sm text-emerald-300 bg-gray-50 p-3 rounded-full mr-2">Base</span>
          </p>
          <p class=" font-bold mb-4 text-slate-400 shadow p-4 rounded-lg w-full"><i
              class="text-sm text-emerald-300 bg-gray-50 p-3 rounded-full mr-2 fa fa-arrow-up"></i>
            {{energieData.electrcite.lastPeakload}} €/kw <span
              class="text-sm text-emerald-300 bg-gray-50 p-3 rounded-full mr-2">Peak</span></p>

        </div>
