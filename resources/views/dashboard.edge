    <div class="w-full p-2 md:w-1/2 lg:w-1/2">

      <div class="p-6 text-center transition duration-500 ease-in-out transform bg-white rounded-lg shadow">

        <h2 class="p-3 mb-1 text-start text-sm font-bold rounded-lg shadow bg-gray-50  text-gray-500 "> <i
            class="duration-75 animate-pulse fa fa-bell text-emerald-500 mr-2"></i> la variation par rapport à la
          semaine
          derniere est de : {{
          Math.round(energieData.electrcite.lastPeakload -
          energieData.electrcite.lastBaseload ) }}
        </h2>

        <div class="row">
          <div class=" w-full flex justify-evenly">
            <div class="w-full m-1">

              <div class="relative max-w-full">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                  <i class="fa fa-calendar-days text-emerald-400"></i>
                </div>
                <input type="text" id="BaseGaz"
                  class="anotherSelector bg-gray-50 border border-none shadow text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full pl-10 p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                  placeholder="Selectionner une date">
              </div>
            </div>

          </div>
        </div>


        <div class="my-2 shadow" id="chart1"> </div>
      </div>
    </div>


    <div class="w-full p-2 md:w-1/2 lg:w-1/2">

      <div
        class=" transform hover:scale-95 transition duration-500  mb-4 ease-in-out bg-white rounded-lg shadow p-6 text-center">
        <h2 class="text-emerald-400 font-bold bg-gray-50 p-3   shadow"><i class="fa fa-fire "></i> Gaz Naturel </h2>
        <div class=" flex justify-evenly  text-center">

          <p class=" font-bold mb-4 text-slate-400  shadow p-4 rounded-lg w-full"> <i
              class="text-sm text-emerald-300 bg-gray-50 p-3 rounded-full mr-2 fa fa-arrow-up"></i>
            {{ energieData.gaz.lastBaseload }} €/kw | <span
              class="text-sm text-emerald-400 bg-gray-50 p-3 rounded-full mr-2">{{ energieData.gaz.lastDate }}</span>
          </p>


        </div>
        <h2 class="text-gray-400 font-bold bg-gray-50 p-3 mb-3 shadow">
          Baseload
        </h2>
        <div class=" flex justify-evenly  text-center">

          <p class="text-sm font-bold mb-4 text-slate-400 shadow p-4 rounded-lg w-full"> <span
              class=" text-emerald-400 bg-gray-100 p-3 rounded-full mr-2">MIN</span> {{ variations.gaz.base.min}}
            €/kw
          </p>
          <p class="text-sm font-bold mb-4 text-slate-400 shadow p-4 rounded-lg w-full"><span
              class=" text-emerald-400 bg-gray-100 p-3 rounded-full mr-2">MAX</span> {{ variations.gaz.base.max }}
            €/kw </p>
          <p class="text-sm font-bold mb-4 text-slate-400 shadow p-4 rounded-lg w-full"><span
              class=" text-sm text-emerald-400 bg-gray-100 p-3 rounded-full mr-2">MOY</span> {{ variations.gaz.base.avg
            }}
            €/kw </p>

        </div>



      </div>
    </div>


    <script>
      let tradedatesGaz = "{{ energieData.gaz.dates }}"
      let tradedatesElec = "{{ energieData.electrcite.dates }}"
      var options2 = {
        chart: {
          type: 'line'
        },
        series: [{
          name: 'Baseload',
          data: [{{ energieData.electrcite.baseload }}]
      },
        {
          name: 'Peaload',
          data: [{{ energieData.electrcite.peakload }}]
            }
          ],
      xaxis: {
        categories: tradedatesElec.split(',')
      },
      colors: ['#34d399', '#334155'],
        stroke: {
        curve: 'smooth',
            }
            };

      var chart2 = new ApexCharts(document.querySelector("#chart2"), options2);

      chart2.render();

      var options1 = {
        chart: {
          type: 'line'
        },
        series: [{
          name: 'sales',
          data: [{{ energieData.gaz.prices }}]

      }],
        xaxis: {
          categories: tradedatesGaz.split(',')
        },
        colors: ['#34d399', '#f7c22e'],
        stroke: {
          curve: 'smooth',
        }
            };

      var chart1 = new ApexCharts(document.querySelector("#chart1"), options1);

      chart1.render();

    </script>
    <script src="js/apexcharts.min.js"></script>
  </div>
</div>
@endsection
