    <script>
      let periodes = document.querySelector('#periodes1','#periodes2')
        periodes.addEventListener('change', () => {
        
        window.location.href = `/dashboard/${periodes.value}`
        
        });



        let dates = "{{ main }}";
        var options1 = {
        chart: {
        type: 'line'
        },
        series: [{
        name: 'sales',
        data: [{{ prix }}]
        
        }],
        xaxis: {
        categories: dates.split(',')
        },
        colors: ['#34d399'] // New color scheme for the chart
        }
        
        var chart1 = new ApexCharts(document.querySelector("#chart1"), options1);
        
        chart1.render();

        var options2 = {
        chart: {
        type: 'line'
        },
